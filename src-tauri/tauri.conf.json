{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T&T Tu Vi Dau So App",
  "version": "1.1.0",
  "identifier": "com.tandthoanggiaroyal.tuvidauso",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "T&T Tu Vi Dau So - An La So & Luan Giai",
        "width": 1200,
        "height": 850,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
